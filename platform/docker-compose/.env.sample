##############################
### User Init Job Settings ###
##############################
# These variables will be used by the init jobs the first time you boot up with a fresh DB
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
INITIAL_REGISTRIES_JSON=""

################
### API KEYS ###
################
# The first time you boot up against a fresh DB, these will be used to configure the api keys for these service accounts
# After that point, they will be used in the relevant pods for authentication with the API
# Note: if these are left blank during your first boot up, they will be initialized to a random key.
# To get Trawler to work, you will need to update the TRAWLER_API_KEY with the generated key
TRAWLER_API_KEY=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
FALCO_API_KEY=
KUBE_HUNTER_API_KEY=
KUBE_BENCH_API_KEY=

##################
### Dash config ##
##################
SECURITY_JWT_SECRET=
SERVER_BASE_URL=http://localhost:3000
# REQUIRED for kube-bench/kube-hunter scanner callbacks. Must be reachable from
# Kubernetes Pods; never set to localhost or 127.0.0.1.
# Example in-cluster: http://m9sweeper-dash.m9sweeper-system.svc.cluster.local:3000
# Example local Kind: use a stable network-reachable gateway / proxy, not a dynamic IP.
SCANNER_REPORT_INGESTION_URL=
# Configure cluster-scoped write grants for trawler/Falco/kube-hunter
# BEFORE setting SCANNER_REQUIRE_CLUSTER_BINDINGS=true.
# false is a migration compatibility setting, not the production baseline.
SCANNER_REQUIRE_CLUSTER_BINDINGS=false
# Move ALL sender credentials to X-API-Key / Secret first, then disable
# legacy query-string credentials and rotate old keys.
SCANNER_ALLOW_LEGACY_QUERY_KEYS=true
# Never export raw scanner keys through browser/API responses.
SCANNER_ALLOW_LEGACY_KEY_EXPORT=false
# SMTP settings
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_DEFAULT_SENDER_EMAIL=
EMAIL_SMTP_AUTH_USER=
EMAIL_SMTP_AUTH_PASSWORD=

###################
### Cron Config ###
###################
# Enable/disable all the cron jobs, and condigure their schedule if needed
NODE_CRON_ENABLED=1
CLUSTER_SCRAPE_SCHEDULE="30 * * * *"
GATEKEEPER_EXCEPTION_SYNC_SCHEDULE="30 * * * *"
KUBERNETES_HISTORY_SCHEDULE="1 0 * * *"
UPDATE_EXCEPTION_STATUS_SCHEDULE="1 0 * * *"

#######################
### Database config ###
#######################
DATABASE_NAME=m9sweeper
DATABASE_USER=postgres
DATABASE_PASSWORD=

###############
### Trawler ###
###############
# 0 for off, 1 for on
TRAWLER_DEBUG=0

###############################
### Docker Compose Settings ###
###############################
KUBESEC_PORT=6116